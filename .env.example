# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# Amazon Bedrock — API key auth (https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html)
AWS_BEARER_TOKEN_BEDROCK=****
# AWS_REGION=us-east-1

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# optional: local PGlite database directory (defaults to ./.pglite)
# PGLITE_DATA_DIR=./.pglite

# https://vercel.com/docs/redis
REDIS_URL=****

# xAI — voice realtime testing at /voice (https://console.x.ai)
# XAI_API_KEY=****
# XAI_VOICE_MODEL=grok-voice-latest

# Fide world-model MCP (optional) — single-line JSON, server name "fide" by default
# MCP_CONFIG={"mcpServers":{"fide":{"url":"https://test.fide.work/mcp","headers":{"x-api-key":"sk_...","x-fide-runner-public-id":"runner_...","x-fide-workspace-public-id":"workspace_..."}}}}
# Or use separate vars: FIDE_API_KEY, FIDE_RUNNER_PUBLIC_ID, FIDE_WORKSPACE_PUBLIC_ID, FIDE_GATEWAY_URL
