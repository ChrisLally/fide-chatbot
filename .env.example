# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****
# Require email/password login (disables auto-guest). Set to 0 to reopen guest demo mode.
AUTH_REQUIRE_LOGIN=1

# Vercel AI Gateway — night/transport rankings (opt-in; off unless JEV_EVALUATE=1|on|true)
# AI_GATEWAY_API_KEY=vck_...
# JEV_EVALUATE=1

# Amazon Bedrock — API key auth (https://docs.aws.amazon.com/bedrock/latest/userguide/api-keys.html)
# Used when LITELLM_* is unset.
AWS_BEARER_TOKEN_BEDROCK=****
# AWS_REGION=us-east-1

# Azure LiteLLM gateway (OpenAI-compatible). When set, chat uses @ai-sdk/openai → this URL.
# LITELLM_BASE_URL=https://….azurecontainerapps.io
# LITELLM_API_KEY=sk-...
# LITELLM_MODEL=claude-sonnet-5
# Fall back to Bedrock Haiku if LiteLLM errors or stalls before first token (default on).
# LITELLM_FALLBACK_BEDROCK=1
# LITELLM_FIRST_BYTE_TIMEOUT_MS=25000

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# optional: local PGlite database directory (defaults to ./.pglite)
# PGLITE_DATA_DIR=./.pglite

# https://vercel.com/docs/redis
REDIS_URL=****

# xAI — voice realtime testing at /voice (https://console.x.ai)
# XAI_API_KEY=****
# XAI_VOICE_MODEL=grok-voice-latest

# Fide world-model MCP (optional) — single-line JSON, server name "fide" by default
# MCP_CONFIG={"mcpServers":{"fide":{"url":"https://test.fide.work/mcp","headers":{"x-api-key":"sk_...","x-fide-runner-public-id":"runner_...","x-fide-workspace-public-id":"workspace_..."}}}}
# Or use separate vars: FIDE_API_KEY, FIDE_RUNNER_PUBLIC_ID, FIDE_WORKSPACE_PUBLIC_ID, FIDE_GATEWAY_URL

# Discord webhook for in-app feedback button (server-only — never expose to the client)
# DISCORD_FEEDBACK_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord webhook for context data uploads (server-only)
# DISCORD_DATA_UPLOAD_WEBHOOK_URL=https://discord.com/api/webhooks/...
